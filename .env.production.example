# Public hostname. Point its DNS A/AAAA record to the server before starting Caddy.
APP_DOMAIN=search.example.com

# PostgreSQL. URL-encode special characters before placing the password in DATABASE_URL.
POSTGRES_USER=visual_search
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=visual_search
DATABASE_URL=postgresql+asyncpg://visual_search:replace-with-a-strong-password@postgres:5432/visual_search

# Authentication. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional initial admin account. Remove these values after the account is created.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_FULL_NAME=System Admin

# Tune these values for the server CPU. Defaults target an 8-vCPU/16-GB host.
AI_CPU_THREADS=8
AI_INFERENCE_THREADS=4
MAX_INDEX_WORKERS=2
OCR_MAX_CONCURRENT_INFERENCE=2
BACKEND_WORKERS=2
